@model NPO_Workflow.ViewModels.TechOps.TechOpViewModel

<form asp-action="Modify" asp-controller="TechOps" method="post">
    @Html.AntiForgeryToken()
    <p class="text-muted small"><span class="text-danger">*</span> — обязательные для заполнения поля</p>
    <hr />
    <div class="row">
        <div class="form-group col-md-6 mb-2">
            <label asp-for="TechnologyId" class="form-label">Наименование детали<span class="text-danger">*</span></label>
            <select asp-for="TechnologyId" asp-items="Model.DetailsList" class="form-select">
                <option value="0">-- Выберите деталь --</option>
            </select>
            <span asp-validation-for="TechnologyId" class="text-danger"></span>
        </div>
        <div class="form-group col-md-6 mb-2">
            <label asp-for="OperationId" class="form-label">Наименование операции<span class="text-danger">*</span></label>
            <select asp-for="OperationId" asp-items="Model.OperationsList" class="form-select">
                <option value="0">-- Выберите операцию --</option>
            </select>
            <span asp-validation-for="OperationId" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer px-0 pb-0 d-flex gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
        <button type="submit" class="btn btn-success">Сохранить</button>
    </div>
</form>
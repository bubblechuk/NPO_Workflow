@model IEnumerable<NPO_Workflow.ViewModels.TechOps.TechOpViewModel>

@{
    int? selectedOpId = ViewBag.SelectedOpId;
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3" id="crud-container" data-controller="@ViewContext.RouteData.Values["controller"]?.ToString()">
    <h1 class="display-6">Технология детали: @ViewBag.DetailName</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-crud-create"><i class="bi-database-add"></i> Добавить тех. операцию</button>
        
        <button type="button" class="btn btn-secondary" id="btn-move-up" @(selectedOpId == null ? "disabled" : "")>
            <i class="bi-caret-up"></i> Поднять
        </button>
        <button type="button" class="btn btn-secondary" id="btn-move-down" @(selectedOpId == null ? "disabled" : "")>
            <i class="bi-caret-down"></i> Опустить
        </button>
    </div>
</div>

<table class="table table-striped text-center" style="table-layout: fixed; width: 100%;">
    <thead class="thead-dark">
        <tr>
            @foreach (var col in ViewBag.Columns)
            {

                <th scope="col" style=@(col.Label == "№" ? "width:100px" : "")>
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-selectedOpId="@selectedOpId"
                       class="text-decoration-none">
                        @col.Label
                    </a>
                </th>
            }
            <th style="width: 60px;"><a class="text-decoration-none">Выбор</a></th>
            <th style="width: 45px;"></th>
            <th style="width: 45px;"></th>
        </tr>
    </thead>
    <tbody class="tbody-operations">
        @foreach (var or in Model)
        {
            bool isCurrentSelected = selectedOpId == or.Id;

            <tr class="align-middle op-row @(isCurrentSelected ? "table-primary fw-bold" : "")" data-id="@or.Id">
                <td class="tdata" title="@or.HierarchyId">@or.HierarchyId</td>
                <td class="tdata" title="@or.OperationId">@or.OperationName</td>
                
                <td>
                    <input type="radio" name="operationSelection" class="op-radio" value="@or.Id" @(isCurrentSelected ? "checked" : "") />
                </td>
                
                <td>
                    <button type="button" class="btn btn-secondary btn-sm btn-crud-modify" title="Редактировать" data-id="@or.Id">
                        <i class="bi-pencil"></i>
                    </button>
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm btn-crud-delete" title="Удалить" data-id="@or.Id">
                        <i class="bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
        @if (Model.Count() < 10)
        {
            int totalColumns = (ViewBag.Columns as System.Collections.ICollection)?.Count ?? 0;
            for (int i = 0; i < 10 - Model.Count(); i++)
            {
                <tr class="align-middle" style="height: 48px;">
                    @for (int j = 0; j < totalColumns + 3; j++)
                    {
                        <td>&nbsp;</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
<partial name="_Pagination"></partial>
<partial name="_Modal"></partial>

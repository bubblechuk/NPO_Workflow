@{
    ViewData["Username"] = User?.Identity?.Name ?? "Anonymous";
}
<h1 class="display-4 text-center m-5">Здравствуйте, @ViewData["Username"]!</h1>
<h1 class="display-6 border-bottom p-3">Уведомления</h1>
<div class="alert alert-info m-3" role="alert">
    <p class="mb-0 d-flex align-items-center gap-2"> <i class="bi bi-info fs-4"></i> Вы идентифицированы системой как: @ViewData["UserName"]
    </p>
</div>

@if (ViewBag.Count > 0)
{
    <div class="alert alert-warning m-3" role="alert">
        <p class="mb-0 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation fs-4"></i> Требуется заполнить сроки для @ViewBag.Count технологий. Нажмите <a href="/Technologies" class="alert-link">здесь</a> чтобы перейти к заполнению 
        </p>
    </div>
} 
@model IEnumerable<NPO_Workflow.ViewModels.Orders.OrderViewModel>

<div class="d-flex justify-content-between align-items-center mt-3 mb-3" id="crud-container" data-controller="@ViewContext.RouteData.Values["controller"]?.ToString()">
    <form method="get" action="@Url.Action("Index", "Orders")">
        <div class="input-group" style="max-width: 200px;">
            <input type="text" class="form-control" placeholder="Поиск..." name="search" value="@Context.Request.Query["search"]">
            <button class="btn btn-primary" type="submit">
                <i class="bi-search"></i>
            </button>
        </div>
    </form>
    <h1 class="display-6">Заказы</h1>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" id="btn-crud-create"><i class="bi-database-add"></i> Добавить заказ</button>
    </div>
</div>
<table class="table table-striped text-center" style="table-layout: fixed; width: 100%;">
    <thead class="thead-dark">
        <tr>
            @foreach (var col in ViewBag.Columns)
            {
                bool isActive = ViewBag.SortBy == col.Key;
                bool nextDesc = isActive && ViewBag.SortOrder == true;
                string widthStyle = col.Key == "Id" ? "width: 60px;" : "";

                <th scope="col" style="@widthStyle">
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-search="@ViewBag.SearchQuery"
                       asp-route-sortBy="@col.Key"
                       asp-route-sortOrder="@(nextDesc ? false : true)"
                       class="text-decoration-none @(isActive ? "fw-bold" : "")">
                        @col.Label @(isActive ? (ViewBag.SortOrder == false ? "▲" : "▼") : "")
                    </a>
                </th>
            }
            <th style="width: 45px;"></th>
            <th style="width: 45px;"></th>
        </tr>
    </thead>
    <tbody class="tbody-operations">
        @foreach (var or in Model)
        {
            <tr class="align-middle">
                <td>@or.Id</td>

                <td class="tdata" title="@or.Name">@or.Name</td>
                <td class="tdata" title="@or.InternationalName">@or.InternationalName</td>
                <td class="tdata" title="@or.Comment">@or.Comment</td>

                <td>
                    <button type="button" class="btn btn-secondary btn-sm btn-crud-modify" title="Редактировать" data-id="@or.Id">
                        <i class="bi-pencil"></i>
                    </button>
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm btn-crud-delete" title="Удалить" data-id="@or.Id">
                        <i class="bi-trash"></i>
                    </button>
                </td>
            </tr>
        }
        @if (Model.Count() < 10)
        {
            int totalColumns = (ViewBag.Columns as System.Collections.ICollection)?.Count ?? 0;
            for (int i = 0; i < 10 - Model.Count(); i++)
            {
                <tr class="align-middle" style="height: 48px;">
                    @for (int j = 0; j < totalColumns + 2; j++)
                    {
                        <td>&nbsp;</td>
                    }
                </tr>
            }
        }
    </tbody>
</table>
<partial name="_Pagination"></partial>
<partial name="_Modal"></partial>
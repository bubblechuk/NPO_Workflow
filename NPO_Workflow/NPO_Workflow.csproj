    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1c261c1e-30d3-4e5c-8029-ba1010908cfd</UserSecretsId>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
